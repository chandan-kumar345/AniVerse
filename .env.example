# ==============================================================================
# ANIVERSES - ENVIRONMENT CONFIGURATION TEMPLATE
# Product: ANIVERSES (Tagline: ANIME BEYOND BORDERS)
# ==============================================================================

# --- Frontend Environment Variables (Vite Client) ---
# Set the backend URL if running Express API separately from client or for deployment proxy
VITE_API_URL=https://aniverse-k94k.onrender.com

# (Optional) Supabase credentials if enabling managed database/auth in place of local SQLite/Prisma
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Note: The AniList GraphQL metadata endpoint (https://graphql.anilist.co)
# is public and requires no API key.

# --- Backend Environment Variables (Express + Prisma) ---
PORT=5000
NODE_ENV=development

# Database connection URL (Default SQLite for local dev; or PostgreSQL for Supabase / Production)
DATABASE_URL="file:./dev.db"

# JWT secret for authentication
JWT_SECRET=aniverse_secure_jwt_secret_change_in_production

# CORS allowed origins (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://aniverses.vercel.app
