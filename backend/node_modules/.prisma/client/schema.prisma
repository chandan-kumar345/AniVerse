datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String? // e.g. "avatar1.png" or custom url
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchlist Watchlist[]
  history   WatchHistory[]
  comments  Comment[]
}

model Anime {
  id           String   @id @default(uuid())
  malId        Int?
  slug         String   @unique
  title        String
  englishTitle String?
  description  String
  bannerImage  String? // Horizontal banner for hero slides
  posterImage  String? // Vertical poster for cards
  rating       String? // e.g. "PG-13", "R - 17+"
  score        Float    @default(0.0) // e.g. 8.78
  type         String   @default("TV") // TV, Movie, OVA, ONA, Special
  studio       String?
  status       String   @default("Finished Airing") // Currently Airing, Finished Airing, Not Yet Aired
  releasedYear Int?
  duration     String? // e.g. "24 min"
  genres       String // Comma-separated (e.g. "Action, Fantasy, Adventure")
  isTrending   Boolean  @default(false)
  isPopular    Boolean  @default(false)
  hasSub       Boolean  @default(true)
  hasDub       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  episodes  Episode[]
  watchlist Watchlist[]
  history   WatchHistory[]
}

model Episode {
  id            String   @id @default(uuid())
  animeId       String
  episodeNumber Int
  title         String
  videoUrl      String // Streaming file URL
  thumbnail     String?
  duration      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  anime   Anime          @relation(fields: [animeId], references: [id], onDelete: Cascade)
  history WatchHistory[]

  @@unique([animeId, episodeNumber])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  animeId   String
  status    String // WATCHING, COMPLETED, PLAN_TO_WATCH, DROPPED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model WatchHistory {
  id                 String   @id @default(uuid())
  userId             String
  animeId            String
  episodeNumber      Int
  watchedTime        Float    @default(0) // seconds
  duration           Float    @default(0) // seconds
  progressPercentage Float    @default(0) // 0 to 100
  updatedAt          DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [animeId, episodeNumber], references: [animeId, episodeNumber], onDelete: Cascade)

  @@unique([userId, animeId])
}

model Comment {
  id            String   @id @default(uuid())
  userId        String
  animeId       String
  episodeNumber Int
  text          String
  parentId      String? // Parent comment ID for threaded replies
  likes         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
}
